// WinBar.qml — barra de tarefas estilo Windows 10 para o Quickshell
//
// Fica na mesma pasta do shell.qml (~/.config/quickshell/topbar/), igual
// ao Dock.qml. Usa só as cores do Colors.qml (matugen):
//   surface            -> fundo da barra
//   surface_container  -> hover / janela ativa / caixa de pesquisa
//   source_color       -> texto e ícones
//   outline            -> texto apagado / sublinhado de janela inativa
//   primary            -> sublinhado da janela ativa
//
// Layout (igual ao print do Windows 10):
//   [Iniciar] [Pesquisar] [Visão de tarefas] [janelas abertas ...]
//   ... [trocar barra] [Área de Trabalho »] [^] [bateria] [rede] [som] [hora/data] [notificações]
//
// Mouse nas janelas: esquerdo = focar (ou abrir, se for app fixado),
// meio = nova instância (só fixados), direito = FECHAR a janela
// (no Hyprland não tem botão de fechar na janela, então ajuda).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Services.UPower
import Quickshell.Services.SystemTray

PanelWindow {
  id: win

  // ---------- vem do shell.qml ----------
  required property var screenRef

  property string nerdFont: "JetBrainsMono NF"
  property var windowRewrite: ({})   // mesmo mapa do windowRewrite do shell.qml
  property var battery: null
  property real volumePct: 0
  property bool muted: false
  property bool hasNetwork: false
  property bool isWired: false
  property bool notifOpen: false

  signal startClicked()
  signal notifClicked()
  signal switchClicked()
  signal muteClicked()
  signal volumeScrolled(real delta)

  // ---------- config ----------
  // apps fixados na barra (opcional). appId é o mesmo que o windowRewrite
  // usa; o ícone sai de lá automaticamente. Exemplo:
  //   { appId: "brave-origin", cmd: ["brave"] },
  property var pinned: []

  // botão "Visão de tarefas". O padrão pressupõe o plugin hyprexpo;
  // troque pelo comando que você preferir (ou deixe [] pra não fazer nada).
  property var taskViewCommand: ["hyprctl", "dispatch", "hyprexpo:expo", "toggle"]

  // ---------- cores (todas vindas do Colors.qml) ----------
  readonly property color cBar: Colors.md3.surface
  readonly property color cHover: Colors.md3.surface_container
  readonly property color cText: Colors.md3.source_color
  readonly property color cMuted: Colors.md3.outline
  readonly property color cAccent: Colors.md3.primary

  readonly property int barH: 40

  // ---------- estado interno ----------
  property bool trayOpen: false
  property string timeText: ""
  property string dateText: ""

  screen: screenRef

  anchors {
    bottom: true
    left: true
    right: true
  }

  implicitHeight: win.barH
  color: win.cBar

  // ---------- relógio (HH:mm / dd/MM/yyyy, como no Windows) ----------
  Timer {
    interval: 5000
    running: true
    repeat: true
    triggeredOnStart: true

    onTriggered: {
      const now = new Date();
      win.timeText = Qt.formatDateTime(now, "HH:mm");
      win.dateText = Qt.formatDateTime(now, "dd/MM/yyyy");
    }
  }

  // ---------- ícone do app: primeiro caractere do rótulo no windowRewrite ----------
  function glyphFor(appId) {
    for (const pattern in win.windowRewrite) {
      if (pattern === "^$") {
        continue;
      }

      if (new RegExp(pattern).test(appId || "")) {
        const label = win.windowRewrite[pattern];
        // pega 1 code point inteiro (glifos Nerd Font de 5 dígitos usam surrogate pair)
        const m = label.match(/^(?:[\uD800-\uDBFF][\uDC00-\uDFFF]|[\s\S])/);

        if (m) {
          return m[0];
        }
      }
    }

    return appId ? appId.charAt(0).toUpperCase() : "?";
  }

  function batteryGlyph() {
    const b = win.battery;

    if (!b) {
      return "\u{F0091}";
    }

    if (b.state === UPowerDeviceState.Charging) {
      return "\u{F0084}";
    }

    const levels = [
      "\u{F008E}", "\u{F007A}", "\u{F007B}", "\u{F007C}", "\u{F007D}", "\u{F007E}",
      "\u{F007F}", "\u{F0080}", "\u{F0081}", "\u{F0082}", "\u{F0079}"
    ];

    return levels[Math.max(0, Math.min(10, Math.round(b.percentage * 10)))];
  }

  function volumeGlyph() {
    if (win.muted || win.volumePct <= 0) {
      return "\u{F0581}";
    }

    if (win.volumePct < 34) {
      return "\u{F057F}";
    }

    if (win.volumePct < 67) {
      return "\u{F0580}";
    }

    return "\u{F057E}";
  }

  function networkGlyph() {
    if (!win.hasNetwork) {
      return "\u{F05AA}";
    }

    return win.isWired ? "\u{F0200}" : "\uf1eb";
  }

  // ---------- janelas: fixados primeiro, depois o resto na ordem de abertura ----------
  readonly property var entries: {
    const wins = ToplevelManager.toplevels.values;
    const claimed = [];
    const out = [];

    for (const p of win.pinned) {
      let found = null;

      for (const w of wins) {
        if (w.appId === p.appId && claimed.indexOf(w) === -1) {
          found = w;
          break;
        }
      }

      if (found) {
        claimed.push(found);
      }

      out.push({ appId: p.appId, cmd: p.cmd, toplevel: found });
    }

    for (const w of wins) {
      if (claimed.indexOf(w) === -1) {
        out.push({ appId: w.appId, cmd: null, toplevel: w });
      }
    }

    return out;
  }

  // ---------- componentes ----------
  component Glyph: Text {
    font.family: win.nerdFont
    font.pixelSize: 16
    color: win.cText
    verticalAlignment: Text.AlignVCenter
  }

  component Label: Text {
    font.family: win.nerdFont
    font.pixelSize: 12
    color: win.cText
    verticalAlignment: Text.AlignVCenter
  }

  // botão chato e retangular, como os da barra do Windows
  component Btn: Rectangle {
    id: b

    property bool highlighted: false
    property real minWidth: 48

    default property alias content: holder.children
    property alias spacing: holder.spacing

    signal clicked(var mouse)
    signal wheel(var wheel)

    Layout.fillHeight: true
    implicitWidth: Math.max(b.minWidth, holder.implicitWidth + 16)

    color: (b.highlighted || area.containsMouse) ? win.cHover : "transparent"

    RowLayout {
      id: holder

      anchors.centerIn: parent
      spacing: 6
    }

    MouseArea {
      id: area

      anchors.fill: parent
      hoverEnabled: true

      onClicked: (mouse) => b.clicked(mouse)
      onWheel: (wheel) => b.wheel(wheel)
    }
  }

  // linha fina no topo, separa a barra do resto
  Rectangle {
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 1
    color: win.cHover
  }

  RowLayout {
    anchors.fill: parent
    anchors.topMargin: 1
    spacing: 0

    // ---- Iniciar ----
    Btn {
      Glyph {
        text: "\uf385" // fa-windows
        font.pixelSize: 18
      }

      onClicked: win.startClicked()
    }

    // ---- caixa de pesquisa ----
    Rectangle {
      id: searchBox

      Layout.fillHeight: true
      Layout.preferredWidth: 260

      color: searchArea.containsMouse ? Qt.lighter(win.cHover, 1.25) : win.cHover

      RowLayout {
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        anchors.leftMargin: 14
        spacing: 12

        Glyph {
          text: "\uf002" // fa-search
          font.pixelSize: 14
          color: win.cMuted
        }

        Label {
          text: "Digite aqui para pesquisar"
          color: win.cMuted
        }
      }

      MouseArea {
        id: searchArea

        anchors.fill: parent
        hoverEnabled: true
        onClicked: win.startClicked()
      }
    }

    // ---- visão de tarefas ----
    Btn {
      Glyph {
        text: "\uf2d2" // fa-window-restore
      }

      onClicked: {
        if (win.taskViewCommand.length > 0) {
          Quickshell.execDetached(win.taskViewCommand);
        }
      }
    }

    // ---- janelas abertas (e fixados) ----
    Item {
      id: taskArea

      Layout.fillWidth: true
      Layout.fillHeight: true
      clip: true

      Row {
        id: tasks

        height: parent.height
        spacing: 0

        Repeater {
          model: win.entries

          delegate: Rectangle {
            id: task

            required property var modelData

            readonly property var tl: modelData.toplevel
            readonly property bool running: tl !== null
            readonly property bool active: running && tl.activated
            readonly property string cls: running ? tl.appId : modelData.appId

            width: 48
            height: tasks.height

            color: (task.active || taskArea2.containsMouse) ? win.cHover : "transparent"

            Glyph {
              anchors.centerIn: parent
              text: win.glyphFor(task.cls)
              font.pixelSize: 20
            }

            // sublinhado: cheio e colorido na ativa, curtinho e apagado nas outras
            Rectangle {
              visible: task.running

              anchors.bottom: parent.bottom
              anchors.horizontalCenter: parent.horizontalCenter

              width: task.active ? parent.width : 16
              height: 2
              color: task.active ? win.cAccent : win.cMuted

              Behavior on width {
                NumberAnimation {
                  duration: 120
                }
              }
            }

            MouseArea {
              id: taskArea2

              anchors.fill: parent
              hoverEnabled: true
              acceptedButtons: Qt.LeftButton | Qt.MiddleButton | Qt.RightButton

              onClicked: (mouse) => {
                if (mouse.button === Qt.RightButton) {
                  if (task.running) {
                    task.tl.close();
                  }
                } else if (mouse.button === Qt.MiddleButton) {
                  if (task.modelData.cmd) {
                    Quickshell.execDetached(task.modelData.cmd);
                  }
                } else if (task.running) {
                  task.tl.activate();
                } else if (task.modelData.cmd) {
                  Quickshell.execDetached(task.modelData.cmd);
                }
              }
            }
          }
        }
      }
    }

    // =================== LADO DIREITO ===================

    // ---- trocar pra topbar ----
    Btn {
      minWidth: 40

      Glyph {
        text: "\uf0ec" // fa-exchange
        font.pixelSize: 14
      }

      onClicked: win.switchClicked()
    }

    // ---- barra de ferramentas "Área de Trabalho »" ----
    Btn {
      minWidth: 0

      Label {
        text: "Área de Trabalho"
        font.pixelSize: 11
      }

      Label {
        text: "»"
        font.pixelSize: 12
      }

      onClicked: Quickshell.execDetached([
        "bash", "-c", "xdg-open \"$(xdg-user-dir DESKTOP)\""
      ])
    }

    // ---- ícones da bandeja (aparecem ao clicar no ^) ----
    Row {
      visible: win.trayOpen && SystemTray.items.values.length > 0

      Layout.alignment: Qt.AlignVCenter
      Layout.leftMargin: 6
      Layout.rightMargin: 6
      spacing: 10

      Repeater {
        model: SystemTray.items.values

        Image {
          required property var modelData

          width: 16
          height: 16
          source: modelData.icon

          MouseArea {
            anchors.fill: parent
            acceptedButtons: Qt.LeftButton | Qt.RightButton

            onClicked: (mouse) => {
              if (mouse.button === Qt.LeftButton) {
                modelData.activate();
              } else if (modelData.hasMenu) {
                const pos = mapToItem(null, mouse.x, mouse.y);
                modelData.display(win, pos.x, pos.y);
              }
            }
          }
        }
      }
    }

    // ---- ^ mostrar ícones ocultos ----
    Btn {
      minWidth: 28
      highlighted: win.trayOpen

      Glyph {
        text: win.trayOpen ? "\uf078" : "\uf077" // fa-chevron-down / fa-chevron-up
        font.pixelSize: 10
      }

      onClicked: win.trayOpen = !win.trayOpen
    }

    // ---- bateria ----
    Btn {
      minWidth: 36

      Glyph {
        text: win.batteryGlyph()
      }
    }

    // ---- rede ----
    Btn {
      minWidth: 36

      Glyph {
        text: win.networkGlyph()
        color: win.hasNetwork ? win.cText : win.cMuted
      }
    }

    // ---- som ----
    Btn {
      minWidth: 36

      Glyph {
        text: win.volumeGlyph()
        color: win.muted ? win.cMuted : win.cText
      }

      onClicked: win.muteClicked()
      onWheel: (wheel) => win.volumeScrolled(wheel.angleDelta.y > 0 ? 0.01 : -0.01)
    }

    // ---- hora e data ----
    Btn {
      minWidth: 76

      ColumnLayout {
        spacing: 0

        Label {
          text: win.timeText
          Layout.alignment: Qt.AlignHCenter
        }

        Label {
          text: win.dateText
          Layout.alignment: Qt.AlignHCenter
        }
      }

      onClicked: win.notifClicked()
    }

    // ---- central de notificações ----
    Btn {
      minWidth: 44
      highlighted: win.notifOpen

      Glyph {
        text: "\uf0e5" // fa-comment-o
        font.pixelSize: 17
      }

      onClicked: win.notifClicked()
    }
  }
}
